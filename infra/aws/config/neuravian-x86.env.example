# Non-secret Neuravian AWS x86 configuration.
# Copy to .neuravian-aws/config.env and keep that generated file untracked.
AWS_REGION=us-east-1
INSTANCE_TYPE=m7i.2xlarge
ROOT_VOLUME_GIB=200
ROOT_VOLUME_TYPE=gp3
ROOT_VOLUME_IOPS=3000
ROOT_VOLUME_THROUGHPUT=125
ROOT_VOLUME_ENCRYPTED=true
ROOT_DELETE_ON_TERMINATION=true
IMDS_HTTP_TOKENS=required
IMDS_HOP_LIMIT=1
NEURAVIAN_VM_COMMIT=8b9614c328463c9dfcb5337303cadde447985299
APPLICATION_BASELINE_COMMIT=aec1aea247659f43a92a8f2fc39208d15a68914a
PROJECT_TAG=Neuravian
PURPOSE_TAG=x86-verification
MANAGED_BY_TAG=NeuravianProvisioner
DEPLOYMENT_ID=auto
SSH_ALLOWED_CIDR=auto
ROOT_MFA_CONFIRMED=false
SESSION_A_MAX_HOURS=4
KEY_STRATEGY=ec2-key-pair
VPC_ID=auto
SUBNET_ID=auto
PREPULL_IMAGES=false
