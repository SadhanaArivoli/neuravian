{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageOneOptionalNeuroForgeBudget",
      "Effect": "Allow",
      "Action": [
        "budgets:ModifyBudget",
        "budgets:ViewBudget"
      ],
      "Resource": "arn:aws:budgets::__ACCOUNT_ID__:budget/NeuroForge-__DEPLOYMENT_ID__"
    },
    {
      "Sid": "ReadBillingViewRequiredByViewBudget",
      "Effect": "Allow",
      "Action": "billing:GetBillingViewData",
      "Resource": "*"
    }
  ]
}
