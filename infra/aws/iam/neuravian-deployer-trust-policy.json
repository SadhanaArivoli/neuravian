{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TrustExactBootstrapPrincipal",
      "Effect": "Allow",
      "Principal": {
        "AWS": "__BOOTSTRAP_PRINCIPAL_ARN__"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalAccount": "__ACCOUNT_ID__"
        }
      }
    }
  ]
}
