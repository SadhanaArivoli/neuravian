# Copy to terraform.tfvars and replace every placeholder. terraform.tfvars is ignored.
deployment_id     = "nf-tf-20260714-example1"
instance_type     = "m7i.2xlarge"
operator_ssh_cidr = "203.0.113.10/32"
ssh_public_key    = "ssh-ed25519 REPLACE_WITH_YOUR_PUBLIC_KEY neuroforge-terraform"
git_commit        = "REPLACE_WITH_EXACT_40_CHARACTER_COMMIT_SHA"

# Optional: open ports 80/443 only after configuring an authenticated HTTPS
# gateway. This never exposes backend port 8000 or frontend container port 3000.
enable_public_frontend = false

# AWS Free account plans cannot launch m7i.2xlarge. Use this smaller x86 shape:
# instance_type = "m7i-flex.large"

# Optional: choose an existing public subnet in the default VPC.
# subnet_id = "subnet-0123456789abcdef0"

# Optional, non-sensitive organizational tags.
additional_tags = {
  Environment = "verification"
}
