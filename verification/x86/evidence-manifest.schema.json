{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuravian.local/schemas/x86-evidence-manifest.schema.json",
  "title": "Neuravian x86 verification evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "created_at", "git_commit", "fixture_id", "files", "redactions"],
  "properties": {
    "schema_version": {"const": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "fixture_id": {"type": "string", "minLength": 1},
    "redactions": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256", "category"],
        "properties": {
          "path": {"type": "string", "pattern": "^[^/].*$"},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "category": {"enum": ["log", "version", "image_digest", "run_metadata", "validation", "report", "screenshot", "checksum", "inventory"]}
        }
      }
    }
  }
}
